{
  "study_name": "camels_simple_tft_light",
  "n_trials": 12,
  "timeout": null,
  "storage": null,
  "output_root": "outputs/optuna_light",
  "epochs": 8,
  "pruner": {
    "type": "median",
    "n_startup_trials": 3,
    "n_warmup_steps": 2,
    "interval_steps": 1
  },
  "search_space": {
    "lr": {
      "type": "float",
      "low": 0.0003,
      "high": 0.0015,
      "log": true
    },
    "weight_decay": {
      "type": "float",
      "low": 0.00005,
      "high": 0.001,
      "log": true
    },
    "dropout": {
      "type": "float",
      "low": 0.1,
      "high": 0.3
    },
    "batch_size": {
      "type": "categorical",
      "choices": [128]
    },
    "d_model": {
      "type": "categorical",
      "choices": [64]
    },
    "lstm_hidden": {
      "type": "categorical",
      "choices": [64]
    },
    "n_heads": {
      "type": "categorical",
      "choices": [4]
    }
  }
}
