{
  "study_name": "K_camels_simple_tft",
  "n_trials": 25,
  "timeout": null,
  "storage": null,
  "output_root": "outputs/optuna",
  "epochs": 20,
  "objective_metric": "best_val_median_nse",
  "pruner": {
    "type": "median",
    "n_startup_trials": 5,
    "n_warmup_steps": 3,
    "interval_steps": 1
  },
  "search_space": {
    "lr": {
      "type": "float",
      "low": 0.0001,
      "high": 0.01,
      "log": true
    },
    "weight_decay": {
      "type": "float",
      "low": 0.0001,
      "high": 0.001,
      "log": true
    },
    "dropout": {
      "type": "float",
      "low": 0.1,
      "high": 0.4
    },
    "batch_size": {
      "type": "categorical",
      "choices": [64, 128]
    },
    "d_model": {
      "type": "categorical",
      "choices": [64, 128]
    },
    "lstm_hidden": {
      "type": "categorical",
      "choices": [64, 128]
    },
    "n_heads": {
      "type": "categorical",
      "choices": [2, 4, 8]  
    }  
  }
}
